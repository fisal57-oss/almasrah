{
  "name": "theater-seat-invitations",
  "private": true,
  "version": "1.0.0",
  "description": "نظام حجز مقاعد المسرح وإدارة الفعاليات",
  "author": "إدارة المسرح والفعاليات",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "app": "concurrently \"vite\" \"wait-on tcp:3000 && electron .\"",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder --win",
    "portable": "vite build && node scripts/build-portable.cjs"
  },
  "build": {
    "appId": "com.theater.seatmanager",
    "productName": "نظام حجز مقاعد المسرح",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام حجز مقاعد المسرح"
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.469.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.11",
    "wait-on": "^9.1.0"
  }
}
